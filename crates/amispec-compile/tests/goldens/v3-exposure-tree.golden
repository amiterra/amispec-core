=== clusters/local/04a-provisioners-day2/jobs.yaml ===
apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    amispec.io/binding-edge: 'keycloak->web:'
  labels:
    amispec.io/cluster-id: local
    amispec.io/component-id: keycloak
    amispec.io/stage: 04a-provisioners-day2
  name: provision-keycloak-a4acfcfa
  namespace: default
spec:
  backoffLimit: 3
  template:
    spec:
      containers:
      - command:
        - sh
        - -c
        - echo provision-binding && exit 0
        image: busybox:1.36
        name: provisioner
      restartPolicy: Never
  ttlSecondsAfterFinished: 86400
