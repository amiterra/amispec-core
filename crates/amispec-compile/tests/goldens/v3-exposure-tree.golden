=== clusters/local/04b-app-migrations-expand/jobs.yaml ===
apiVersion: batch/v1
kind: Job
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/component-id: web
    amispec.io/stage: 04b-app-migrations-expand
  name: migrate-expand-web-a1897b25
  namespace: dmz-public
spec:
  backoffLimit: 3
  template:
    spec:
      containers:
      - command:
        - sh
        - -c
        - echo expand-schema && exit 0
        image: busybox:1.36
        name: migrate
      restartPolicy: Never
  ttlSecondsAfterFinished: 86400
---
