kind: Deployment
metadata:
  annotations:
    amispec.io/user-spec-delta: '{"backupTarget":null,"config":null,"group":null,"resources":{"cpuCores":1.0,"memoryMb":256},"topology":{"committedReplicas":null,"mode":"standalone","replicas":2,"shards":null},"workloadOverride":null,"zone":"dmz-public"}'
    reloader.stakater.com/auto: 'true'
  labels:
    amispec.io/cluster-id: local
    amispec.io/component-id: web
    amispec.io/passport: stateless-app.1.0.0-rev1
    amispec.io/stage: 05-applications
    amispec.io/zone: dmz-public
    app.kubernetes.io/instance: web
    app.kubernetes.io/name: web
  name: web
  namespace: dmz-public
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: web
  template:
    metadata:
      annotations:
        amispec.io/user-spec-delta: '{"backupTarget":null,"config":null,"group":null,"resources":{"cpuCores":1.0,"memoryMb":256},"topology":{"committedReplicas":null,"mode":"standalone","replicas":2,"shards":null},"workloadOverride":null,"zone":"dmz-public"}'
        reloader.stakater.com/auto: 'true'
      labels:
        amispec.io/cluster-id: local
        amispec.io/component-id: web
        amispec.io/passport: stateless-app.1.0.0-rev1
        amispec.io/stage: 05-applications
        amispec.io/zone: dmz-public
        app.kubernetes.io/instance: web
        app.kubernetes.io/name: web
    spec:
      containers:
      - image: stateless-app:1.0.0
        name: app
        resources:
          limits:
            memory: 256Mi
          requests:
            cpu: '1'
            memory: 256Mi
      securityContext:
        fsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
      terminationGracePeriodSeconds: 65
