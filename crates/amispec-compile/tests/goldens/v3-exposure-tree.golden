=== clusters/local/05-applications/routes.yaml ===
apiVersion: v1
kind: Service
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/component-id: web
    amispec.io/passport: stateless-app.1.0.0-rev1
    amispec.io/stage: 05-applications
  name: web
  namespace: dmz-public
spec:
  ports:
  - name: web
    port: 8080
    protocol: TCP
    targetPort: 8080
  - name: admin
    port: 9090
    protocol: TCP
    targetPort: 9090
  selector:
    app.kubernetes.io/name: web
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  annotations:
    amispec.io/host: example.io
    amispec.io/host-source: hostname
    amispec.io/host-value: example.io
    amispec.io/path-prefix: /api/v2
    amispec.io/security-policy: '{"corsAllowedOrigins":["https://app.example.io"],"rateLimitRps":500}'
  labels:
    amispec.io/cluster-id: local
    amispec.io/component-id: web
    amispec.io/endpoint: web
    amispec.io/lb-layer: l7-gateway
    amispec.io/passport: stateless-app.1.0.0-rev1
    amispec.io/scope: public
    amispec.io/stage: 05-applications
    amispec.io/via-balancer: main-l7
  name: web-web
  namespace: dmz-public
spec:
  hostnames:
  - example.io
  parentRefs:
  - name: main-l7
    namespace: flux-system
  rules:
  - backendRefs:
    - name: web
      port: 8080
    filters:
    - responseHeaderModifier:
        set:
        - name: Access-Control-Allow-Origin
          value: https://app.example.io
        - name: Access-Control-Allow-Methods
          value: GET, POST, PUT, PATCH, DELETE, OPTIONS
        - name: Access-Control-Allow-Headers
          value: Authorization, Content-Type
      type: ResponseHeaderModifier
    matches:
    - path:
        type: PathPrefix
        value: /api/v2
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  annotations:
    amispec.io/host: admin.example.io
    amispec.io/host-source: subdomain
    amispec.io/host-value: admin
    amispec.io/path-prefix: /
    amispec.io/security-policy: '{"clientAuth":"oidc"}'
  labels:
    amispec.io/cluster-id: local
    amispec.io/component-id: web
    amispec.io/endpoint: admin
    amispec.io/lb-layer: l7-gateway
    amispec.io/passport: stateless-app.1.0.0-rev1
    amispec.io/scope: protected
    amispec.io/stage: 05-applications
    amispec.io/via-balancer: main-l7
  name: web-admin
  namespace: dmz-public
spec:
  hostnames:
  - admin.example.io
  parentRefs:
  - name: main-l7
    namespace: flux-system
  rules:
  - backendRefs:
    - name: web
      port: 9090
    matches:
    - path:
        type: PathPrefix
        value: /
---
apiVersion: v1
kind: Service
metadata:
  annotations:
    amispec.io/floating-ip-ref: fip-01
    amispec.io/host-source: none
    amispec.io/host-value: ''
    amispec.io/path-prefix: /
    service.cilium.io/lb-algorithm: maglev
    service.cilium.io/lb-mode: dsr
    service.cilium.io/lb-proxy-protocol: v2
  labels:
    amispec.io/cluster-id: local
    amispec.io/component-id: web
    amispec.io/endpoint: mqtt
    amispec.io/lb-layer: l4-balancer
    amispec.io/passport: stateless-app.1.0.0-rev1
    amispec.io/scope: public
    amispec.io/stage: 05-applications
    amispec.io/via-balancer: mqtt-l4
  name: web-mqtt
  namespace: dmz-public
spec:
  allocateLoadBalancerNodePorts: false
  ports:
  - name: data
    port: 1883
    protocol: TCP
    targetPort: 1883
  selector:
    app.kubernetes.io/name: web
  type: LoadBalancer
