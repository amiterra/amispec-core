=== clusters/local/01-node-tuning/crd.yaml ===
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  labels:
    amispec.io/stage: 01-node-tuning
  name: nodetuningprofiles.tuning.amispec.io
spec:
  group: tuning.amispec.io
  names:
    kind: NodeTuningProfile
    listKind: NodeTuningProfileList
    plural: nodetuningprofiles
    singular: nodetuningprofile
  scope: Cluster
  versions:
  - name: v1alpha1
    schema:
      openAPIV3Schema:
        type: object
        x-kubernetes-preserve-unknown-fields: true
    served: true
    storage: true
=== clusters/local/01-node-tuning/profiles.yaml ===
apiVersion: tuning.amispec.io/v1alpha1
kind: NodeTuningProfile
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/node-id: n1
    amispec.io/stage: 01-node-tuning
  name: local-n1
spec:
  disks: []
  failureDomainZone: null
  hardware:
    arch: amd64
    cpuCores: 2.0
    lvmSnapshotReservePercent: 10
    memoryMb: 4096
    systemDiskReservedGb: 40
    systemReservedMb: 1280
  nodeSelector:
    kubernetes.io/hostname: n1
  role: control-plane-worker
=== clusters/local/01-node-tuning/kustomization.yaml ===
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
- crd.yaml
- profiles.yaml
=== clusters/local/02-operators-and-networking/networking.yaml ===
apiVersion: v1
data:
  clusterMeshId: '1'
  engine: cilium-ebpf
  fqdnCacheMinTtlSec: '3600'
  mtuDiscoveryAndMssClamp: 'true'
  podCIDR: 10.101.0.0/16
  serviceCIDR: 10.201.0.0/16
  wireguardEncryption: 'true'
kind: ConfigMap
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/stage: 02-operators-and-networking
  name: local-cni
  namespace: kube-system
=== clusters/local/02-operators-and-networking/balancer-activation.yaml ===
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/exposure: 'true'
    amispec.io/stage: 02-operators-and-networking
  name: cilium
  namespace: kube-system
spec:
  valuesContent: |
    envoy:
      enabled: true
    rollOutCiliumPods: true
    operator:
      replicas: 1
      tolerations:
        - operator: Exists
      image:
        useDigest: false
        digest: ""
      rollOutPods: true
    bpf:
      masquerade: true
      hostRouting: true
      tproxy: true
    l2announcements:
      enabled: true
    gatewayAPI:
      enabled: true
---
apiVersion: v1
kind: Namespace
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/stage: 02-operators-and-networking
  name: cert-manager
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/stage: 02-operators-and-networking
  name: jetstack
  namespace: cert-manager
spec:
  interval: 1h
  url: https://charts.jetstack.io
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/stage: 02-operators-and-networking
  name: cert-manager
  namespace: cert-manager
spec:
  chart:
    spec:
      chart: cert-manager
      sourceRef:
        kind: HelmRepository
        name: jetstack
        namespace: cert-manager
      version: v1.16.2
  interval: 1h
  values:
    installCRDs: true
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  annotations:
    amispec.io/lb-provider: cilium-envoy
    amispec.io/tls: letsencrypt-http01
    amispec.io/tls-mode-resolved: letsencrypt-http01
    amispec.io/vip-reachability: l2-announce
  labels:
    amispec.io/cluster-id: local
    amispec.io/lb-id: main-l7
    amispec.io/lb-layer: l7-gateway
    amispec.io/stage: 02-operators-and-networking
  name: main-l7
spec:
  acme:
    privateKeySecretRef:
      name: main-l7-acme-account
    server: https://acme-v02.api.letsencrypt.org/directory
    solvers:
    - http01:
        gatewayHTTPRoute:
          parentRefs:
          - kind: Gateway
            name: main-l7
            namespace: flux-system
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  annotations:
    amispec.io/lb-provider: cilium-envoy
    amispec.io/tls: letsencrypt-http01
    amispec.io/tls-mode-resolved: letsencrypt-http01
    amispec.io/vip-reachability: l2-announce
  labels:
    amispec.io/cluster-id: local
    amispec.io/lb-id: main-l7
    amispec.io/lb-layer: l7-gateway
    amispec.io/stage: 02-operators-and-networking
  name: main-l7-admin-example-io
  namespace: flux-system
spec:
  dnsNames:
  - admin.example.io
  issuerRef:
    kind: ClusterIssuer
    name: main-l7
  secretName: main-l7-admin-example-io-tls
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  annotations:
    amispec.io/lb-provider: cilium-envoy
    amispec.io/tls: letsencrypt-http01
    amispec.io/tls-mode-resolved: letsencrypt-http01
    amispec.io/vip-reachability: l2-announce
  labels:
    amispec.io/cluster-id: local
    amispec.io/lb-id: main-l7
    amispec.io/lb-layer: l7-gateway
    amispec.io/stage: 02-operators-and-networking
  name: main-l7-example-io
  namespace: flux-system
spec:
  dnsNames:
  - example.io
  issuerRef:
    kind: ClusterIssuer
    name: main-l7
  secretName: main-l7-example-io-tls
---
apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/lb-id: main-l7
    amispec.io/lb-layer: l7-gateway
    amispec.io/stage: 02-operators-and-networking
  name: main-l7-l2
spec:
  loadBalancerIPs: true
  serviceSelector:
    matchLabels:
      io.kubernetes.service.name: cilium-gateway-main-l7
---
apiVersion: v1
data:
  checklist: |-
    - populate CiliumLoadBalancerIPPool address blocks from floatingIpRef via Day-2 node inventory (Design Doc 0022)
    - configure BGP peering on nodes (Design Doc 0022)
    - confirm Proxy Protocol v2 termination at the upstream path when enabled
  floatingIpRef: fip-01
  forwardingMode: ebpf-dsr-maglev
kind: ConfigMap
metadata:
  annotations:
    amispec.io/floating-ip-ref: fip-01
    amispec.io/forwarding-mode: ebpf-dsr-maglev
    amispec.io/lb-provider: cilium-l4-bgp
    amispec.io/proxy-protocol-v2: 'true'
    amispec.io/tls-mode-resolved: none
    amispec.io/vip-reachability: l2-announce
  labels:
    amispec.io/cluster-id: local
    amispec.io/lb-id: mqtt-l4
    amispec.io/lb-layer: l4-balancer
    amispec.io/stage: 02-operators-and-networking
  name: mqtt-l4-l4-prereqs
  namespace: flux-system
---
apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/lb-id: mqtt-l4
    amispec.io/lb-layer: l4-balancer
    amispec.io/stage: 02-operators-and-networking
  name: mqtt-l4-l2
spec:
  loadBalancerIPs: true
  serviceSelector:
    matchExpressions:
    - key: io.kubernetes.service.name
      operator: In
      values:
      - web-mqtt
