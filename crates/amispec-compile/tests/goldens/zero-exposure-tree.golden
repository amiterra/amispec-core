=== clusters/local/06-zero-trust-and-observability/netpols.yaml ===
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/stage: 06-zero-trust-and-observability
  name: local-kube-dns-guard
  namespace: kube-system
spec:
  egress:
  - toEndpoints:
    - matchLabels:
        k8s:k8s-app: kube-dns
    toPorts:
    - ports:
      - port: '53'
        protocol: ANY
  endpointSelector: {}
---
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  labels:
    amispec.io/cluster-id: local
    amispec.io/component-id: web
    amispec.io/stage: 06-zero-trust-and-observability
  name: local-web-egress
  namespace: default
spec:
  egress:
  - toEndpoints:
    - matchLabels:
        k8s:k8s-app: kube-dns
  endpointSelector:
    matchLabels:
      app.kubernetes.io/name: web
